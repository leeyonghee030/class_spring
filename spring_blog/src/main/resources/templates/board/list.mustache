{{> layout/header}}

<div class="container p-5">
    {{#boardPage.content}}
        <div class="card mb-3">
            <div class="card-body">
                <h4 class="card-title">{{title}}</h4>
                <p>{{username}} | 작성일 {{createdAt}}</p>
                <a href="/board/{{id}}" class="btn btn-primary">상세보기</a>
            </div>
        </div>
    {{/boardPage.content}}
    {{!게시글이 없을 떄}}
    {{^boardPage.content}}
        <div class="text-cent mt5" >
            <h5> 게시글이 없습니다 </h5>
        </div>
    {{/boardPage.content}}

<!--    페이지네이션 (추후구현 예정)-->
    <ul class="pagination d-flex justify-content-center">
        {{#boardPage.hasPrevious}}
        <li class="page-item ">
            <a class="page-link" href="/?page={{boardPage.previousPage}}&size={{boardPage.size}}">Previous</a>
        </li>
        {{/boardPage.hasPrevious}}
        {{^boardPage.hasPrevious}}
            <li class="page-item disabled "><a class="page-link" href="#">Previous</a></li>
        {{/boardPage.hasPrevious}}

        {{! 페이지 링크 번호 }}
        {{#boardPage.pagesLinks}}
            <li class="page-item {{#active}}active{{/active}}" >
            <a class="page-link" href="/?page={{number}}&size = {{boardPage.size}}">{{number}}</a>
        </li>
        {{/boardPage.pagesLinks}}

        {{!다음 만들기}}
        {{#boardPage.hasNext}}
        <li class="page-item">
            <a class="page-link" href="/?page={{boardPage.NextPage}}&size={{boardPage.size}}">Next</a>
        </li>
        {{/boardPage.hasNext}}

        {{^boardPage.hasNext}}
        <li class="page-item disabled "><a class="page-link" href="#">Next</a></li>
        {{/boardPage.hasNext}}
    </ul>
</div>

{{> layout/footer}}