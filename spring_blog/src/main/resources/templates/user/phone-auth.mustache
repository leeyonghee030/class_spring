{{> layout/header}}


<div class="card">
    <div class="card-header"><b>휴대폰 인증</b></div>
    <div class="card-body">
        <div class="input-group">
            <input type="text" class="form-control mb-1" placeholder="전화번호" name="phone" id="phone">
            <button type="button" class="btn btn-outline-secondary"
                    id="send-btn" onclick="sendCone()" >인증번호 전송</button>
        </div>
        <div class="mb-3" id="code-box">
            <div class="input-group">
                <input type="text " class="form-control" id="code" placeholder="인증번호 6자리" maxlength="10">
                <button type="button" class="btn btn-outline-secondary" id="send-code-btn" onclick="verifyCode()">확인</button>
            </div>
            <div id="msg" class="form-text"></div>
        </div>
        <div class=" mt-3">
            <a href="/user/detail" class="btn btn-secondary">목록으로 돌아가기</a>
        </div>
    </div>
</div>

<script>
    //1.인증번호 전송
    let cooldownTimer = null;

    function startCooldown(seconds) {
        const sendBtn = document.querySelector("#send-btn");
        let remaining = seconds;
        sendBtn.disabled = true;
        sendBtn.innerText = remaining + "초 후 재전송";

        clearInterval(cooldownTimer);
        cooldownTimer = setInterval(() => {
            remaining--;
            if (remaining <= 0) {
                clearInterval(cooldownTimer);
                sendBtn.disabled = false;
                sendBtn.innerText = "인증번호 전송";
            } else {
                sendBtn.innerText = remaining + "초 후 재전송";
            }
        }, 1000);
    }

    async function sendCone() {
        const phone = document.querySelector("#phone").value;

        if (!phone) {
            alert("전화번호를 입력해주세요")
            return
        }

        const sendBtn = document.querySelector("#send-btn");
        sendBtn.disabled = true;
        sendBtn.innerText = "전송중 ...";

        try {
            const response = await fetch("/api/sms/send", {
                method: "POST",
                headers: {"Content-Type": "application/Json"},
                body: JSON.stringify({phone: phone})
            });

            const result = await response.json();
            alert(result.message);

            if (response.ok) {
                startCooldown(60); // 성공했을 때만 60초 잠금
            } else {
                sendBtn.disabled = false;
                sendBtn.innerText = "인증번호 전송";
            }
        }catch (e) {
            alert("서버와 통신하지 못했습니다");
            sendBtn.disabled = false;
            sendBtn.innerText = "인증번호 전송";
        }
    }

    //2. 인증번호 확인 전송
    async function verifyCode() {
        //사용자 이메일, 인증코드 (6자리)
        const  phone = document.querySelector("#phone").value;
        const code = document.querySelector("#code").value;

        if (!code){
            alert("인증번호를 입력해주세요")
            return
        }
        try {
            const  response = await fetch("/api/sms/verify", {
                method: "POST",
                headers: {"Content-Type" : "application/json"},
                body: JSON.stringify({phone: phone, code: code})// 객체 -? json
            });
            const  result = await  response.json(); //json -> 객체
            const msgBox = document.querySelector("#msg");
            if (response.ok) {
                msgBox.innerText = result.message;
                msgBox.className = "form-text text-success";
                //인증한 이메일을 화면단에서 바꾸지 못하게 잠금 설정
                document.querySelector("#phone").readOnly = true;
                document.querySelector("#send-btn").disabled = true;
                document.querySelector("#code").readOnly = true;
                document.querySelector("#send-code-btn").disabled = true;


            } else {
                msgBox.innerText = result.message;
                msgBox.className = "form-text text-danger";
            }
        }catch (e) {
            alert("서버와 통신하지 못했습니다")
        }
    }
</script>

{{> layout/footer}}